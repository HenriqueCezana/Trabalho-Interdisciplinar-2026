{
    "compilerOptions": {
        "rootDir": "./src/frontend",
        "outDir": "./dist/frontend",
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "strict": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": [
        "src/frontend/app.ts",
        "src/frontend/pages/**/*",
        "src/frontend/service/**/*"
    ]
}